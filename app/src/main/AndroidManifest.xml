<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For finding covers online, when asked to, downloading the language data for text recognition, and talking
         to KoLib on the user's other devices on the same network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a newer KoLib from its GitHub releases, when the user says to. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Scanning another device's pairing QR code. Asked for only when Scan QR code is tapped; KoLib works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- So the Wi-Fi hands KoLib the "here I am" other devices with KoLib send to everyone on the network. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- To carry on making a scanned book into text with the app closed, with a notification saying how far it's got. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- To carry on sending to (or taking in from) the user's other devices with the app closed, and to stay
         reachable from them when asked to. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Used only to recognise which Kobo model is plugged in. Not required to install. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- So the reader can offer the dictionary and translation apps installed, for Look up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Android's own screens for unmounting the Kobo's drive, which Eject offers when they're there. -->
        <intent>
            <action android:name="android.provider.action.DOCUMENT_ROOT_SETTINGS" />
            <data android:scheme="content" android:host="com.android.externalstorage.documents" android:mimeType="vnd.android.document/root" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.externalstorage.documents" android:mimeType="vnd.android.document/root" />
        </intent>
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <package android:name="com.sec.android.app.myfiles" />
        <!-- The apps Android may open when a Kobo is connected (file managers that take USB drives), so KoLib can
             say how to stop one taking over, and offer itself in their place. -->
        <intent>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent>
    </queries>

    <application
        android:name=".KoLibApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KoLib">
        <!-- Android 16 ignores an app's choice of portrait or landscape on a tablet (smallest width 600dp and up) unless
             its aspect ratio is App default in Android's settings. Opted out, KoLib is App default from install, so the
             readers' Rotation buttons turn the screen whatever auto-rotate is set to; without it, it's Full screen and
             they can't. Taking Full screen off that list instead changes nothing. (Both tried on a tablet with Android
             16.) The opt-out ends for apps that target API 37. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.KoLib.Starting"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Each paired device at the top of other apps' Share (and in KoLib's shortcuts). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- "Share" a book to the app, or open one with it, to add it to the library. Plain text and
                 web pages aren't listed: KoLib would be offered for every one, though it takes them from the file picker. -->
            <intent-filter android:label="@string/add_to_library">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
            </intent-filter>
            <intent-filter android:label="@string/add_to_library">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
            </intent-filter>
        </activity>

        <!-- The readers, on a screen of their own, as Mihon's reader is: turned the way they're to be read as they open,
             and made anew as they turn (no configChanges). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.KoLib"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lets Android offer KoLib when a Kobo is connected, beside any file manager that takes USB drives, so
             KoLib can be the app that opens (and stays open) rather than the file manager. It's turned on only
             while such an app is installed: otherwise Android would ask about KoLib each time the Kobo connects. -->
        <activity-alias
            android:name=".KoboConnected"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/kobo_usb" />
        </activity-alias>

        <!-- Starts KoLib again after its language is changed. -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Reads scanned pages in the background (text recognition, on the device). -->
        <service
            android:name=".ocr.OcrService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hears which file manager the user chose to add books with, to open it straight away the next time. -->
        <receiver android:name=".ui.components.FileManagerChosen" android:exported="false" />
        <receiver android:name=".update.Updater$InstallReceiver" android:exported="false" />

        <!-- Keeps a download of an AI model going while the app is in the background. -->
        <service
            android:name=".ai.AiDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Keeps the AI answering while the app is out of sight. -->
        <service
            android:name=".ai.AiAnswerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Sends to, and takes in from, KoLib on the user's other devices while the app is closed. -->
        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- "Send to device" in other apps' Share: text to a paired device's clipboard, files to its Downloads.
             Turned on once a device is paired. -->
        <activity
            android:name=".link.ShareToDeviceActivity"
            android:label="@string/send_to_device"
            android:exported="true"
            android:enabled="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.KoLib.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
