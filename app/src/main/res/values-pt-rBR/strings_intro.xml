    <string name="intro_kobo_title">Conecte seu Kobo</string>
    <string name="intro_kobo_step1">Conecte o Kobo a este dispositivo com um cabo de dados USB-C.</string>
    <string name="intro_kobo_step2">Na tela do Kobo, toque em Conectar.</string>
    <string name="intro_kobo_step3">Só na primeira vez: permita que o KoLib use a unidade do Kobo.</string>
    <string name="intro_kobo_waiting">Aguardando o Kobo…</string>
    <string name="intro_kobo_detected">Abrindo o Kobo… Não o desconecte.</string>
    <string name="intro_kobo_allow">Permitir acesso ao Kobo</string>
    <string name="intro_kobo_allow_help">O Android abre o seletor de pastas na unidade do Kobo. Toque em “Usar esta pasta” e depois em “Permitir”.</string>
    <string name="intro_kobo_working">Abrindo o Kobo…</string>
    <string name="intro_kobo_connected">Conectado ao seu %1$s.</string>
    <string name="intro_kobo_failed">Não foi possível abrir o Kobo. Desconecte, conecte de novo e tente outra vez.</string>
    <string name="intro_kobo_retry">Tentar de novo</string>
    <string name="intro_kobo_later">Está sem o Kobo agora? Pule esta etapa e conecte depois na aba Kobo.</string>
    <string name="intro_collections_title">Coleções no seu Kobo</string>
    <string name="intro_collections_text">O KoLib pode adicionar livros às coleções do Kobo, mas não pode criá-las. Crie a coleção no Kobo primeiro.</string>
    <string name="intro_collections_how">No Kobo, vá em Meus livros, depois em Coleções, e toque em Nova coleção.</string>
    <string name="intro_reading_title">Configure seu leitor</string>
    <string name="intro_reading_text">Escolha a cor da página, a fonte e o tamanho do texto em um livro de exemplo, e veja como o leitor funciona. Leva cerca de um minuto.</string>
    <string name="intro_reading_start">Configurar a leitura</string>
    <string name="intro_reading_later">Agora não</string>

    <string name="intro_done_title">Tudo pronto</string>
    <string name="intro_done_text">Adicione livros quando quiser com o botão Adicionar livros, e envie-os para o seu Kobo quando ele estiver conectado.</string>
    <string name="intro_start">Ir para minha biblioteca</string>
</resources>
