<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KoboLibrary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- While the app starts: the dark the opening animation begins from. -->
    <style name="Theme.KoboLibrary.Starting">
        <item name="android:windowBackground">@color/opening_night</item>
    </style>
    <!-- While the app starts, with the opening animation off (Android 12 and later show the mark). -->
    <style name="Theme.KoboLibrary.Starting.Mark" />
</resources>
