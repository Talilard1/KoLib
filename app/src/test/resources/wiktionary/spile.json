{"en":[{"partOfSpeech":"Noun","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\"><span class=\"ib-brac\">(</span><span class=\"ib-content\"><a rel=\"mw:WikiLink\" href=\"/wiki/obsolete\" title=\"obsolete\">obsolete</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/dialectal\" title=\"dialectal\">dialectal</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/Cumbria\" title=\"Cumbria\">Cumbria</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/Lancashire\" title=\"Lancashire\">Lancashire</a></span><span class=\"ib-brac\">)</span></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/splinter\" title=\"splinter\">splinter</a>."},{"definition":"A <a rel=\"mw:WikiLink\" href=\"/wiki/spigot\" title=\"spigot\">spigot</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/plug\" title=\"plug\">plug</a> used to stop the hole in a <a rel=\"mw:WikiLink\" href=\"/wiki/barrel\" title=\"barrel\">barrel</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/cask\" title=\"cask\">cask</a>."}]},{"partOfSpeech":"Noun","language":"English","definitions":[{"definition":"A <a rel=\"mw:WikiLink\" href=\"/wiki/pile\" title=\"pile\">pile</a>; a <a rel=\"mw:WikiLink\" href=\"/wiki/post\" title=\"post\">post</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/girder\" title=\"girder\">girder</a>."}]}]}
